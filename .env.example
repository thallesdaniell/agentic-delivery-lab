# Copie para .env e preencha. O .env é ignorado pelo Git.

# GitHub App instalado só no repositório-alvo (ver docs/github-app.md)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=~/.config/agentic-delivery-lab/github-app.pem

# Repositório onde o agente abre os PRs
TARGET_REPO=thallesdaniell/agentic-delivery-target

# Chave da API da Anthropic usada pelo worker
ANTHROPIC_API_KEY=

# Teto global de custo e tempo máximo por run. Cada agente (agents/*.json) tem modelo e teto
# próprios; o run usa o menor entre o teto do agente e este.
RUN_BUDGET_USD=1.00
RUN_TIMEOUT=20m

# Porta do board em localhost
BOARD_PORT=8090
